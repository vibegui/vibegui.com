# Generated by build, no need to version.
# Everything scripts/finalize.ts writes on a Cloudflare Pages build lives here:
# versioning it only made every PR carry the asset-hash churn of ~50 article
# shells. What stays versioned is what Pages CANNOT rebuild, since Vite never
# runs there (SKIP_DEPENDENCY_INSTALL): dist/assets/*.js|css, dist/index.html
# (finalize reads it to learn the asset names), dist/images/, favicon,
# site.webmanifest.
dist/content/
dist/context/
dist/bookmarks/
dist/article/
dist/en/article/
dist/en/index.html
dist/en/feed.xml
dist/irene/
dist/malvados/
dist/_dominio-irene/
dist/_dominio-malvados/
dist/.vite/
dist/assets/404.html
dist/sitemap.xml
dist/robots.txt
dist/feed.xml
dist/_redirects
dist/_headers
dist/_routes.json

# Generated at build time (regenerated at dev/build time)
public/bookmarks/data.json
public/content/
.build/

# Test results
test-results/
playwright-report/

temp/

# Local data directory (not versioned)
data/

supabase/.build/
supabase/.temp/

# Personal AI OS Worker
mcp/.dev.vars
mcp/.wrangler/
mcp/dist/
.claude/worktrees/
