# Cloudflare Pages Headers
# https://developers.cloudflare.com/pages/platform/headers/

# HTML pages - short cache with stale-while-revalidate
# (covers index.html, /article/*/index.html, /context/*/index.html)
/*.html
  Cache-Control: public, max-age=30, stale-while-revalidate=3600, stale-if-error=10800

/article/*
  Cache-Control: public, max-age=30, stale-while-revalidate=3600, stale-if-error=10800

/context/*
  Cache-Control: public, max-age=30, stale-while-revalidate=3600, stale-if-error=10800

/irene/*
  Cache-Control: public, max-age=30, stale-while-revalidate=3600, stale-if-error=10800

/malvados/*
  Cache-Control: public, max-age=30, stale-while-revalidate=3600, stale-if-error=10800

# Strip images never change - long cache
/malvados/tirinhas/*
  Cache-Control: public, max-age=31536000, immutable

# Hashed bundles only — real files under /assets/*.js|css|…
# Missing paths must NOT inherit this (see public/assets/404.html); otherwise a
# deploy race can SPA-fallback to index.html and pin text/html as immutable.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/assets/*.map
  Cache-Control: public, max-age=31536000, immutable

# Fonts - long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

